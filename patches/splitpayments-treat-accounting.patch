+async def _record_outcome(identifier, state, **kwargs):
+    if identifier:
+        from lnbits.extensions.cyberherd.services.treats import outcome
+
+        await outcome(identifier, state, **kwargs)
+
+
+def _payment_done(future):
+    if future.cancelled():
+        return
+    error = future.exception()
+    if error:
+        logger.error("Splitpayments: outgoing task failed")
+    elif future.result():
+        logger.info(future.result())
+
+
+async def _below_receiver_minimum(address, amount_msat):
+    # Inspect typed metadata, never classify a receiver/network error by its text.
+    from lnurl import handle, LnurlPayResponse
+    from lnbits.settings import settings
+
+    try:
+        response = await handle(address, user_agent=settings.user_agent, timeout=10)
+        return (
+            isinstance(response, LnurlPayResponse)
+            and amount_msat < response.minSendable
+        )
+    except Exception:
+        return False
